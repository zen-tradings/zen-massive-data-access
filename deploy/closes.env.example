# /etc/massive-access/closes.env — read by massive-access-closes.service
# (not the API key; that lives in /etc/massive-access/key)

# Universe: union of what the PPO and rule-based workers need.
SYMBOLS="SMH SOXX QQQ XLK XLE VDE XOP XLU ITA XPH"

# Calendar days to fetch. 730 days ~ 500 sessions.
LOOKBACK_DAYS=730

# Fail if fewer sessions come back (PPO / SMA200 need >= 200).
MIN_SESSIONS=200
