[Unit]
Description=Massive daily adjusted closes -> /var/lib/massive-access
Wants=network-online.target
After=network-online.target
# Retries below are capped: first run + 5 retries, 20 min apart (~17:00-18:40 ET).
StartLimitIntervalSec=4h
StartLimitBurst=6
# Optional alerting: point this at your own notifier unit.
# OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
User=massive
Group=massive
Environment=MASSIVE_CONFIG_FILE=/etc/massive-access/key
EnvironmentFile=/etc/massive-access/closes.env
# $SYMBOLS (no braces) is split on whitespace into separate arguments.
ExecStart=/opt/massive-access/venv/bin/massive-access closes $SYMBOLS \
    --lookback-days ${LOOKBACK_DAYS} \
    --min-sessions ${MIN_SESSIONS} \
    --fail-on-stale \
    --out /var/lib/massive-access
# Data not published yet (or a transient API error) -> exit 1 -> retry later.
Restart=on-failure
RestartSec=20min
TimeoutStartSec=10min

# Creates /var/lib/massive-access owned by massive; readable by other users.
StateDirectory=massive-access
StateDirectoryMode=0755

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0022
